# ============================================================================
# Support Desk AI - deployment environment variables
# ============================================================================
# Copy these into your host's environment/secrets UI (Railway, Render, Fly,
# Docker, etc.). Do NOT commit the filled-in version.
#
# Nested settings use a double underscore: LLM__GEMINI__API_KEY -> llm.gemini.api_key
# ============================================================================

# --- REQUIRED --------------------------------------------------------------
# The app will not start unless all six of these are set.

# Must be one of: development | staging | production
# (no usable default - omitting this is a startup error)
ENVIRONMENT=production

# Your Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Rejected if blank or containing: xxxxx, your-key, placeholder, change-me
LLM__GEMINI__API_KEY=

# Required even though only Gemini is used: the settings model declares the
# claude and openai sub-configs as mandatory. These values are never called
# while LLM__PROVIDER=gemini, but must be present and non-placeholder.
LLM__CLAUDE__API_KEY=sk-ant-unused-gemini-provider-selected
LLM__OPENAI__API_KEY=sk-unused-gemini-provider-selected

# Vector store. Use qdrant for any serverless/containerised deploy: chromadb
# needs a writable disk that Vercel does not provide.
VECTOR_DB__PROVIDER=qdrant

# Qdrant Cloud cluster. Create a free cluster at https://cloud.qdrant.io
# The collection is created automatically on first start (768 dims, cosine).
VECTOR_DB__QDRANT__URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
VECTOR_DB__QDRANT__API_KEY=
VECTOR_DB__QDRANT__COLLECTION_NAME=customer_service_kb

# Sign your own sessions/tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- STRONGLY RECOMMENDED --------------------------------------------------

# Selects Gemini. Defaults to "both" (Claude primary, OpenAI fallback), which
# is NOT what you want here - set it explicitly.
LLM__PROVIDER=gemini
LLM__FALLBACK_ENABLED=false

LLM__GEMINI__MODEL=gemini-2.5-flash
LLM__GEMINI__MAX_TOKENS=4096
LLM__GEMINI__TEMPERATURE=0.7
LLM__GEMINI__TIMEOUT=60

# Turn off debug in production.
DEBUG=false

# Most platforms inject PORT; map it to API__PORT in your start command if so.
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=false
API__WORKERS=1

# Lock CORS to your real domain (JSON array).
API__ALLOWED_ORIGINS=["https://your-domain.com"]

LOGGING__LEVEL=INFO
LOGGING__FORMAT=json

# --- FILE STORAGE ----------------------------------------------------------
# Uploaded documents go to Vercel Blob when this token is present, and to the
# local filesystem otherwise. Enable Storage -> Blob on the Vercel project and
# the token is injected automatically; you do not need to paste it by hand.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# --- LOCAL DEVELOPMENT ------------------------------------------------------
# With no Qdrant URL and no blob token, the app falls back to ChromaDB on disk
# and a local knowledge_base directory - which is what .env already does.
# VECTOR_DB__CHROMADB__PATH=./data/chroma
# VECTOR_DB__CHROMADB__COLLECTION_NAME=customer_service_kb

# --- NOT NEEDED ------------------------------------------------------------
# Nothing in the current app connects to Postgres or Redis. Both have working
# defaults and no service is contacted, so leave them unset unless you add
# features that use them.
# DATABASE__URL=
# REDIS__URL=
